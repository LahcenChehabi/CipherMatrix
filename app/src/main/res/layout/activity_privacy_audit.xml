<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HEURISTIC PRIVACY DECOMPILER"
        android:textColor="#00FF41"
        android:textSize="20sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:gravity="center"/>

    <TextView
        android:id="@+id/tv_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CORE STATUS: COMPILER IDLE // READINESS 100%"
        android:textColor="#FF3333"
        android:fontFamily="monospace"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:textStyle="bold"/>

    <ProgressBar
        android:id="@+id/progress_audit"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_terminal_audit"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#010101"
        android:padding="16dp"
        android:textColor="#00FF41"
        android:fontFamily="monospace"
        android:textSize="14sp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:lineSpacingMultiplier="1.3"
        android:text="READY TO INITIALIZE REVERSE CRYPTO INTERFACE..." />

    <Button
        android:id="@+id/btn_start_audit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#101010"
        android:text="EXECUTE COUNTER-SURVEILLANCE"
        android:textColor="#00FF41"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:padding="16dp"
        android:textSize="15sp"/>

</LinearLayout>